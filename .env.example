# Trading Agent Mpu Gandring: Indodax spot only.
# Docker keeps real secrets (database passwords, the Indodax master key) in ./.secrets, and the dashboard
# stores Indodax and AI provider keys encrypted in PostgreSQL. Do not put those keys in this file.
# Values below are used by local development and as defaults.

# PAPER simulates trades. LIVE only applies to the Indodax SL monitor and needs the typed confirmation in the panel.
TRADING_MODE=PAPER
APP_MODE=local
PORT=8787
WEB_PORT=5173
HOST=127.0.0.1

# Default AI provider for the six agents. Set it per agent in the Setup window, or here.
# Providers: openai (any OpenAI-compatible endpoint), anthropic, openrouter, xai, deepseek, gemini, local, mock.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=
DEFAULT_REASONING_EFFORT=

# Indodax pairs offered in the pickers. The debate accepts any pair listed on Indodax.
WATCHLIST=BTCIDR,ETHIDR,SOLIDR

# PAPER session defaults. Stops and take profit are percentages of the entry price.
PAPER_BALANCE=1000000
DEFAULT_STOP_PCT=5
TAKE_PROFIT_PCT=10
MIN_ENTRY_CONFIDENCE_PCT=65
DAILY_LOSS_LIMIT_PCT=3

# Pace of the agent debate in milliseconds. 0 disables the delay (used by tests).
DEBATE_PACE_MS=700

# Kill switch latch file. Releasing it needs the owner on this computer: npm run unkill -- --yes
KILL_SWITCH_FILE=data/kill-switch.json

# Optional Telegram alerts. Commands from Telegram need CHANNEL_COMMANDS=on and an allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
CHANNEL_COMMANDS=off
